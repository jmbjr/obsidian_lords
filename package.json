{
  "name": "obsidian-lords",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:fetch && npm run data:normalize && vite build",
    "check": "eslint .",
    "preview": "vite preview",
    "data:fetch": "node pd2/scripts/fetch-data.mjs",
    "data:check": "node pd2/scripts/fetch-data.mjs --check",
    "data:normalize": "node pd2/scripts/normalize-poison-strike.mjs",
    "data:test": "npm run data:fetch && npm run data:normalize && node --test pd2/tests/poison-strike.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "vite": "7.1.12"
  }
}
